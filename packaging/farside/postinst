#!/bin/sh
# SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
set -eu
[ "$1" = configure ] || exit 0

# Copy only. Stock KDE KRDP and the old fork remain recoverable from their own
# config, certificates and unit drop-ins. This script never starts a service.
old=/etc/krdp
new=/etc/farside
install -d -m 0700 "$new"
# Sol's console certificate predates /etc/krdp. Copy it into Farside's
# configuration directory so the new unit has no dependency on a legacy path.
for kind in crt key; do
    source_file="/opt/krdp-console/cert/krdp.$kind"
    target_file="$new/console.$kind"
    if [ -f "$source_file" ] && [ ! -L "$source_file" ] && [ ! -e "$target_file" ]; then
        cp -a --no-clobber "$source_file" "$target_file"
    fi
done
copy_config() {
    name=$1
    [ -f "$old/$name" ] && [ ! -L "$old/$name" ] || return 0
    [ ! -e "$new/$name" ] && [ ! -L "$new/$name" ] || return 0
    tmp=$(mktemp "$new/.${name}.XXXXXX")
    if sed -e 's/KRDP_/FARSIDE_/g' -e 's@/etc/krdp/@/etc/farside/@g' \
        -e 's@/usr/bin/krdp-@/usr/bin/farside-@g' \
        -e 's@/opt/krdp-console/cert/krdp.crt@/etc/farside/console.crt@g' \
        -e 's@/opt/krdp-console/cert/krdp.key@/etc/farside/console.key@g' \
        -e 's@/usr/share/krdp/@/usr/share/farside/@g' "$old/$name" >"$tmp"; then
        chmod --reference="$old/$name" "$tmp"
        mv -n "$tmp" "$new/$name"
    fi
    [ ! -e "$tmp" ] || rm -f "$tmp"
}
for config in virtual-host.conf virtual-session.conf console-host.conf; do copy_config "$config"; done
for file in "$old"/*.crt "$old"/*.key; do
    [ -f "$file" ] && [ ! -L "$file" ] || continue
    target="$new/${file##*/}"
    [ -e "$target" ] || cp -a --no-clobber "$file" "$target"
done

# The journal is copied when the old session units are quiescent. If retained
# desktops are still running, the rollout migrates it after stopping the broker
# while leaving those desktops untouched.
if [ -d /var/lib/krdp/virtual-sessions ] && [ ! -e /var/lib/farside/virtual-sessions ]; then
    if ! systemctl list-units --all --no-legend 'krdp-virtual-session@*.service' 2>/dev/null | grep -q ' active '; then
        install -d -m 0700 /var/lib/farside
        cp -a /var/lib/krdp/virtual-sessions /var/lib/farside/virtual-sessions
    fi
fi

for pair in 'krdp-console-host.service farside-console-host.service' \
            'krdp-virtual-host.service farside-virtual-host.service' \
            'krdp-virtual-session@.service farside-virtual-session@.service'; do
    set -- $pair
    source_dir="/etc/systemd/system/$1.d"
    target_dir="/etc/systemd/system/$2.d"
    [ -d "$source_dir" ] || continue
    install -d -m 0755 "$target_dir"
    for source_file in "$source_dir"/*.conf; do
        [ -f "$source_file" ] && [ ! -L "$source_file" ] || continue
        target_file="$target_dir/${source_file##*/}"
        [ ! -e "$target_file" ] || continue
        tmp=$(mktemp "$target_dir/.copy.XXXXXX")
        sed -e 's/KRDP_/FARSIDE_/g' -e 's@/etc/krdp/@/etc/farside/@g' \
            -e 's@/usr/bin/krdp-@/usr/bin/farside-@g' \
            -e 's@/opt/krdp-console/cert/krdp.crt@/etc/farside/console.crt@g' \
            -e 's@/opt/krdp-console/cert/krdp.key@/etc/farside/console.key@g' \
            -e 's@/usr/share/krdp/@/usr/share/farside/@g' "$source_file" >"$tmp"
        chmod --reference="$source_file" "$tmp"
        mv -n "$tmp" "$target_file"
        [ ! -e "$tmp" ] || rm -f "$tmp"
    done
done

# BEGIN farside-greeter-setting
# Console at the SDDM greeter needs the greeter KWin to authorize
# farside-console-worker for zkde_screencast_unstable_v1. KWin looks the worker up
# in the sddm user's ksycoca cache, which indexes no applications unless the
# greeter runs with XDG_MENU_PREFIX=plasma-. SDDM drop-ins replace a key's value, so
# the generated file carries the merged value: the effective GreeterEnvironment of
# the existing configuration plus any missing item. Only GreeterEnvironment is set.
# Nothing is written unless /etc/sddm.conf.d exists (SDDM installed); no foreign
# file is edited; a same-named file without our marker is left alone. sddm is never
# restarted: the setting applies at the next greeter start.
farside_greeter_setting() {
    root=$1
    dir=$root/etc/sddm.conf.d
    target=$dir/30-farside-greeter.conf
    marker='# Managed by farside-server (removed on purge); override with a later-sorting drop-in'
    [ -d "$dir" ] || return 0
    if [ -e "$target" ] || [ -L "$target" ]; then
        { [ ! -L "$target" ] && grep -qxF "$marker" "$target"; } || return 0
    fi
    current=
    if [ -f "$root/etc/sddm.conf" ]; then
        value=$(sed -n 's/^GreeterEnvironment=//p' "$root/etc/sddm.conf" | tail -n 1)
        [ -z "$value" ] || current=$value
    fi
    for file in "$dir"/*.conf; do
        [ -f "$file" ] && [ "$file" != "$target" ] || continue
        value=$(sed -n 's/^GreeterEnvironment=//p' "$file" | tail -n 1)
        [ -z "$value" ] || current=$value
    done
    merged=$current
    for item in QT_WAYLAND_SHELL_INTEGRATION=layer-shell XDG_MENU_PREFIX=plasma-; do
        case ",$merged," in
        *",${item%%=*}="*) ;;
        *) merged=${merged:+$merged,}$item ;;
        esac
    done
    tmp=$(mktemp "$dir/.farside-greeter.XXXXXX") || return 0
    printf '%s\n[General]\nGreeterEnvironment=%s\n' "$marker" "$merged" >"$tmp"
    chmod 0644 "$tmp"
    if [ -f "$target" ] && cmp -s "$tmp" "$target"; then
        rm -f "$tmp"
    else
        mv -f "$tmp" "$target"
        echo "farside-server: set the SDDM greeter environment ($target)." >&2
        echo "farside-server: it applies at the next greeter start (reboot, or 'systemctl restart sddm' when nobody is logged in)." >&2
    fi
    return 0
}
farside_greeter_cache() {
    command -v kbuildsycoca6 >/dev/null && command -v runuser >/dev/null || return 0
    sddm_home=$(getent passwd sddm | cut -d: -f6) || return 0
    [ -n "$sddm_home" ] && [ -d "$sddm_home" ] || return 0
    runuser -u sddm -- env HOME="$sddm_home" LANG=C.UTF-8 XDG_MENU_PREFIX=plasma- \
        XDG_DATA_DIRS=/usr/local/share:/usr/share XDG_CONFIG_DIRS=/etc/xdg \
        QT_QPA_PLATFORM=offscreen kbuildsycoca6 --noincremental >/dev/null 2>&1 || true
}
# END farside-greeter-setting
farside_greeter_setting "${DPKG_ROOT:-}" || true
if [ -z "${DPKG_ROOT:-}" ] && [ -f /etc/sddm.conf.d/30-farside-greeter.conf ]; then
    farside_greeter_cache || true
fi

if command -v deb-systemd-helper >/dev/null; then
    for pair in 'krdp-console-host.service farside-console-host.service' \
                'krdp-virtual-host.service farside-virtual-host.service'; do
        set -- $pair
        if deb-systemd-helper --quiet was-enabled "$1"; then
            deb-systemd-helper enable "$2" >/dev/null || true
            install -d -m 0700 /var/lib/farside
            printf '%s\n' "$1 -> $2" >>/var/lib/farside/migrated-units
        fi
        deb-systemd-helper update-state "$2" >/dev/null || true
    done
    if deb-systemd-helper --quiet --user was-enabled app-org.kde.krdpserver.service; then
        deb-systemd-helper --user enable app-io.github.westers.farside.server.service >/dev/null || true
    fi
    deb-systemd-helper --user update-state app-io.github.westers.farside.server.service >/dev/null || true
fi
if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
fi
exit 0
