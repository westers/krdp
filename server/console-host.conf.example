# TLS material for farside-console-host.service. The host creates a self-signed ECDSA P-256
# certificate (10 years) here when there is none, renews it within 30 days of expiry and keeps
# a valid one; a symlinked pair is left to the administrator.
FARSIDE_CONSOLE_CERTIFICATE=/etc/farside/console.crt
FARSIDE_CONSOLE_CERTIFICATE_KEY=/etc/farside/console.key

# Video quality cap and congestion adaptation. Adaptation defaults to false.
#FARSIDE_CONSOLE_QUALITY=80
#FARSIDE_CONSOLE_ADAPTIVE_QUALITY=false
#FARSIDE_CONSOLE_PREFER_AUDIO_QUALITY=false
#FARSIDE_CONSOLE_STANDARD_CLIENT_MEDIA=true
#FARSIDE_CONSOLE_CAMERA_LOOPBACK_DEVICE=none

# Private codecs (HEVC/AV1) in software: auto (default), never or prefer.
#FARSIDE_CONSOLE_SOFTWARE_ENCODING=auto

# AV1 tiles for the Farside client: auto (default: tile rows by picture height when the client
# decodes AV1 in software or does not say, one tile when it decodes in hardware), 1, 2, 4, 8 or 16.
#FARSIDE_CONSOLE_AV1_TILES=auto

# VA-API driver for the capture workers, like krdpserver's VaapiDriverMode: auto (default; a
# LIBVA_DRIVER_NAME set in the desktop session is respected), off, radeonsi, iHD or i965.
#FARSIDE_CONSOLE_VAAPI_DRIVER=auto

# Keep Console separate from the stock KRDP or legacy Farside user server on :3389.
FARSIDE_CONSOLE_ADDRESS=0.0.0.0
FARSIDE_CONSOLE_PORT=3391
