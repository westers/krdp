# Optional overrides for farside-virtual-host.service.
# Copy to /etc/farside/virtual-host.conf and restart that service.
FARSIDE_VIRTUAL_ADDRESS=0.0.0.0
FARSIDE_VIRTUAL_PORT=3395
FARSIDE_VIRTUAL_CERTIFICATE=/etc/farside/virtual-host.crt
FARSIDE_VIRTUAL_CERTIFICATE_KEY=/etc/farside/virtual-host.key

#FARSIDE_VIRTUAL_QUALITY=80
# The highest quality a client may request for its own connection (0 = the same as QUALITY; a client never exceeds it).
#FARSIDE_VIRTUAL_CLIENT_QUALITY_MAX=0
#FARSIDE_VIRTUAL_ADAPTIVE_QUALITY=false
#FARSIDE_VIRTUAL_PREFER_AUDIO_QUALITY=false
#FARSIDE_VIRTUAL_STANDARD_CLIENT_MEDIA=true
#FARSIDE_VIRTUAL_CAMERA_LOOPBACK_DEVICE=none
#FARSIDE_VIRTUAL_SOFTWARE_ENCODING=auto
#FARSIDE_VIRTUAL_SOFTWARE_AVC=auto
#FARSIDE_VIRTUAL_SOFTWARE_HEVC=auto
#FARSIDE_VIRTUAL_SOFTWARE_AV1=auto
#FARSIDE_VIRTUAL_AV1_TILES=auto

# Text clipboard bridge between the client and the desktop: both (default), host-to-client,
# client-to-host or off.
#FARSIDE_VIRTUAL_CLIPBOARD_DIRECTION=both
