# Draft independent desktop service; not installed until launcher integration
# and privileged Sol acceptance are complete. Never PartOf the RDP broker.
[Unit]
Description=KRDP retained virtual desktop %i
After=systemd-user-sessions.service

[Service]
Type=exec
User=root
Slice=system.slice
Delegate=no
Environment=KRDP_VIRTUAL_RENDER_PCI=
EnvironmentFile=-/etc/krdp/virtual-session.conf
ExecStart=/usr/bin/env -i PATH=/usr/bin:/bin LANG=C.UTF-8 @CMAKE_INSTALL_PREFIX@/bin/krdp-virtual-session-entry --session %i --device-entry @CMAKE_INSTALL_PREFIX@/bin/krdp-virtual-device-entry --guardian @CMAKE_INSTALL_PREFIX@/bin/krdp-virtual-guardian --pam-keeper @CMAKE_INSTALL_PREFIX@/bin/krdp-virtual-pam-keeper --launcher @CMAKE_INSTALL_PREFIX@/share/krdp/virtual-session/launch-virtual-session.sh --worker @CMAKE_INSTALL_PREFIX@/bin/krdp-console-worker --support @CMAKE_INSTALL_PREFIX@/share/krdp/virtual-session/support --render-pci ${KRDP_VIRTUAL_RENDER_PCI}
UMask=0077
StandardInput=null
StandardOutput=journal
StandardError=journal
KillMode=mixed
TimeoutStopSec=60
Restart=no
