# Draft only: install as /etc/pam.d/krdp-virtual-session after root acceptance.
# Authentication already happened at the RDP broker; this stack must never
# become an alternative password-authentication policy.
auth requisite pam_deny.so
@include common-account
# Unlike common-session's optional pam_systemd, failure here must block launch.
session required pam_unix.so
# Desktop is a generation-bound keeper marker supplied via PAM environment.
# It must not be copied into the sibling Plasma application's environment.
session required pam_systemd.so class=background type=wayland
