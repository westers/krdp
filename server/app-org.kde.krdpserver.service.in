[Unit]
Description=Farside Server
After=plasma-xdg-desktop-portal-kde.service
After=plasma-core.target

# AUD-FIX F2: restart after a crash (exit 255 on Sol was not "abnormal"),
# but give up after 5 failures in 2 minutes instead of looping.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=exec
ExecStart=@CMAKE_INSTALL_PREFIX@/bin/farside-server
Restart=on-failure
RestartPreventExitStatus=75
RestartSec=3
# OPT-055 K6.1: the main thread pings every 10 s; 90 s without a ping means the daemon is deaf.
# systemd then sends SIGABRT (core per host policy) and SIGKILL after TimeoutAbortSec.
WatchdogSec=90s
NotifyAccess=main
TimeoutAbortSec=30s

[Install]
WantedBy=plasma-workspace.target
