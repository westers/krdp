<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
  <kcfgfile name="krdpserverrc"/>
  <group name="General">
    <entry name="ListenPort" type="Int">
      <label>The port the server listens on</label>
      <default>3389</default>
    </entry>
      <entry name="AutogenerateCertificates" type="Bool">
      <label>Are certificates autogenerated during server start</label>
      <default>true</default>
    </entry>
    <entry name="Certificate" type="String">
      <label>The certificate to use for TLS connections</label>
    </entry>
    <entry name="CertificateKey" type="String">
      <label>The key that matches the TLS certificate</label>
    </entry>
    <entry name="Quality" type="Int">
      <label>The quality of the video stream</label>
      <default>75</default>
    </entry>
    <entry name="AdaptiveQuality" type="Bool">
      <label>Steer the video quality from measured goodput and RTT, up to Quality as a cap</label>
      <default>true</default>
    </entry>
    <entry name="Codec" type="String">
      <label>Video codec: auto (AVC444v2/AVC444 when the client supports it, else AVC420), avc420 (always), avc444 (auto, warning when the client cannot)</label>
      <default>auto</default>
    </entry>
    <entry name="PreferAudioQuality" type="Bool">
      <label>Prefer playback and microphone quality and latency over video quality under congestion; clients may override this live</label>
      <default>false</default>
    </entry>
    <entry name="Avc444MotionGapMs" type="Int">
      <label>AVC444: minimum quiet time (ms) since the last frame before a frame carries the chroma (aux) picture</label>
      <default>100</default>
    </entry>
    <entry name="Avc444RestMs" type="Int">
      <label>AVC444: delay (ms) after a luma-only frame with no successor before an aux-only refresh packet is sent</label>
      <default>150</default>
    </entry>
    <entry name="Avc444MaxGapMs" type="Int">
      <label>AVC444: maximum time (ms) without an aux picture before the next frame carries one regardless of motion</label>
      <default>1500</default>
    </entry>
    <entry name="MonitorMode" type="String">
      <label>Display target mode (workspace, primary, specific, multi, virtual)</label>
      <default>workspace</default>
    </entry>
    <entry name="MonitorIndex" type="Int">
      <label>Display target monitor ID when monitor mode is specific</label>
      <default>0</default>
    </entry>
    <entry name="VirtualMonitorPolicy" type="String">
      <label>With MonitorMode=virtual: replace (switch the physical outputs off while a client is connected) or extend (keep them)</label>
      <default>replace</default>
    </entry>
    <entry name="VirtualMonitorLayout" type="String">
      <label>With MonitorMode=virtual: client (one virtual output per client monitor), single (one output at the client's desktop size), or physical (one output per enabled physical monitor, mirroring its layout)</label>
      <default>client</default>
    </entry>
    <entry name="VirtualMonitorFallbackSize" type="String">
      <label>With MonitorMode=virtual: output size used when the client advertises no usable size (WIDTHxHEIGHT)</label>
      <default>1920x1080</default>
    </entry>
    <entry name="VaapiDriverMode" type="String">
      <label>VAAPI driver selection mode (auto, off, radeonsi, iHD)</label>
      <default>auto</default>
    </entry>
    <entry name="WakeDisplayOnConnect" type="Bool">
      <label>Wake the display when a client starts streaming and keep it awake for the session</label>
      <default>true</default>
    </entry>
    <entry name="CameraLoopbackDevice" type="String">
      <label>Optional V4L2 loopback device to publish redirected cameras for applications that cannot use PipeWire directly</label>
      <default></default>
    </entry>
    <entry name="Users" type="StringList">
      <label>Users allowed to login, passwords are stored in KWallet</label>
    </entry>
    <entry name="SystemUserEnabled" type="Bool">
      <label>Whether the current user can log in via PAM</label>
      <default>false</default>
    </entry>
    <entry name="Autostart" type="Bool">
      <label>Autostart the server on login</label>
      <default>false</default>
    </entry>
  </group>
</kcfg>
