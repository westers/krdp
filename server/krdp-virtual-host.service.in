# Retained-desktop broker. Disabled by default; configure /etc/farside/virtual-host.conf first.
[Unit]
Description=Farside virtual-desktop broker
After=network-online.target systemd-logind.service
Wants=network-online.target

# Restart on failure, but stop after 10 failures in 5 minutes (AUD-FIX F2).
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=exec
Environment=FARSIDE_VIRTUAL_ADDRESS=0.0.0.0
Environment=FARSIDE_VIRTUAL_PORT=3395
# The host creates this certificate when it is missing and renews it when it expires within
# 30 days (AUD-FIX7); /etc/farside/virtual-host.conf may point elsewhere.
Environment=FARSIDE_VIRTUAL_CERTIFICATE=/etc/farside/virtual-host.crt
Environment=FARSIDE_VIRTUAL_CERTIFICATE_KEY=/etc/farside/virtual-host.key
# Private codecs in software (HEVC/AV1): auto, never or prefer (KRDPCTL-V2-CONTRACT.md (e)).
Environment=FARSIDE_VIRTUAL_SOFTWARE_ENCODING=auto
# Software encoders per codec (OPT-062): auto (follows SoftwareEncoding), allowed, or never (H.264: last-resort).
# Hardware encoders are always allowed; a connection that asks for software gets it only where allowed here.
Environment=FARSIDE_VIRTUAL_SOFTWARE_AVC=auto
Environment=FARSIDE_VIRTUAL_SOFTWARE_HEVC=auto
Environment=FARSIDE_VIRTUAL_SOFTWARE_AV1=auto
Environment=FARSIDE_VIRTUAL_QUALITY=80
# The highest quality a client may ask for in its codec request (OPT-066): 0 = the same as QUALITY, else 10-100.
Environment=FARSIDE_VIRTUAL_CLIENT_QUALITY_MAX=0
Environment=FARSIDE_VIRTUAL_ADAPTIVE_QUALITY=false
Environment=FARSIDE_VIRTUAL_PREFER_AUDIO_QUALITY=false
Environment=FARSIDE_VIRTUAL_STANDARD_CLIENT_MEDIA=true
Environment=FARSIDE_VIRTUAL_CAMERA_LOOPBACK_DEVICE=none
# AV1 tiles for the Farside client: auto, 1, 2, 4, 8 or 16 (KRDPCTL-V2-CONTRACT.md (e)).
Environment=FARSIDE_VIRTUAL_AV1_TILES=auto
# Clipboard bridge for text, formatted text and images (OPT-067, OPT-072, OPT-077): both, host-to-client, client-to-host or off.
Environment=FARSIDE_VIRTUAL_CLIPBOARD_DIRECTION=both
# File copy (OPT-078): both, host-to-client, client-to-host or off. Only host-to-client is implemented; the clipboard direction above also applies.
Environment=FARSIDE_VIRTUAL_CLIPBOARD_FILES=both
# The most a file transfer may take of the link: auto (no ceiling), balanced, or MB/s from 0.1 to 1000. Transfers yield to video and audio either way.
Environment=FARSIDE_VIRTUAL_CLIPBOARD_FILE_MAX_RATE=auto
# Free space that must remain on the host after a file copy from the client (OPT-078): bytes or a number with K, M, G or T; 0 = 5% of the filesystem, at least 2 GiB and at most 8 GiB.
Environment=FARSIDE_VIRTUAL_CLIPBOARD_FILE_MIN_FREE=0
EnvironmentFile=-/etc/farside/virtual-host.conf
# Publish the world-readable public-metadata snapshot the settings panel reads without a password.
ExecStartPre=-@KDE_INSTALL_FULL_LIBEXECDIR@/farside-host-settings-helper --publish virtual
ExecStartPre=-@KDE_INSTALL_FULL_LIBEXECDIR@/farside-host-settings-helper --publish session
ExecStart=/usr/bin/env -i PATH=/usr/bin:/bin LANG=C.UTF-8 HOME=/var/lib/farside/virtual-host @CMAKE_INSTALL_PREFIX@/bin/farside-virtual-host --certificate ${FARSIDE_VIRTUAL_CERTIFICATE} --certificate-key ${FARSIDE_VIRTUAL_CERTIFICATE_KEY} --address ${FARSIDE_VIRTUAL_ADDRESS} --port ${FARSIDE_VIRTUAL_PORT} --quality ${FARSIDE_VIRTUAL_QUALITY} --client-quality-max ${FARSIDE_VIRTUAL_CLIENT_QUALITY_MAX} --adaptive-quality ${FARSIDE_VIRTUAL_ADAPTIVE_QUALITY} --prefer-audio-quality ${FARSIDE_VIRTUAL_PREFER_AUDIO_QUALITY} --standard-client-media ${FARSIDE_VIRTUAL_STANDARD_CLIENT_MEDIA} --camera-loopback-device ${FARSIDE_VIRTUAL_CAMERA_LOOPBACK_DEVICE} --software-encoding ${FARSIDE_VIRTUAL_SOFTWARE_ENCODING} --software-avc ${FARSIDE_VIRTUAL_SOFTWARE_AVC} --software-hevc ${FARSIDE_VIRTUAL_SOFTWARE_HEVC} --software-av1 ${FARSIDE_VIRTUAL_SOFTWARE_AV1} --av1-tiles ${FARSIDE_VIRTUAL_AV1_TILES} --clipboard-direction ${FARSIDE_VIRTUAL_CLIPBOARD_DIRECTION} --clipboard-files ${FARSIDE_VIRTUAL_CLIPBOARD_FILES} --clipboard-file-max-rate ${FARSIDE_VIRTUAL_CLIPBOARD_FILE_MAX_RATE} --clipboard-file-min-free ${FARSIDE_VIRTUAL_CLIPBOARD_FILE_MIN_FREE}
StateDirectory=farside/virtual-sessions farside/virtual-host
StateDirectoryMode=0700
UMask=0077
KillMode=control-group
Restart=on-failure
RestartSec=3

# Do not add User=root: with NoNewPrivileges and the seccomp directives systemd 259 then drops CAP_SETUID and the worker launch fails (Sol 2026-11-12).
# A system unit already runs as root by default.
# Without User= systemd does not export HOME/USER/LOGNAME; FreeRDP needs HOME (KNOWN_PATH_HOME) or every connection is refused (Sol 2026-11-12).
# So the root identity is exported explicitly (nothing in a broker reads SHELL; the broker itself runs under `env -i` below with its own HOME, so this reaches the ExecStartPre helpers).
Environment=HOME=/root USER=root LOGNAME=root
# REVIEW-S2 hardening (docs/unit-hardening.md has the evidence, the Sol checklist and a one-line rollback per directive).
# The broker starts no child process of its own (retained desktops are the separate farside-virtual-session@ units it starts
# over D-Bus), so the mount-namespace directives are safe here. It writes only /etc/farside (certificate), StateDirectory and
# /var/lib/farside-public. No device-policy, MemoryDenyWriteExecute or SystemCallFilter directives: it probes GPU encoders.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=~CAP_SYS_MODULE CAP_SYS_RAWIO CAP_SYS_BOOT CAP_SYS_TIME CAP_SYS_PACCT CAP_SYS_TTY_CONFIG CAP_LINUX_IMMUTABLE CAP_MKNOD CAP_WAKE_ALARM CAP_BLOCK_SUSPEND CAP_SYSLOG CAP_BPF CAP_PERFMON CAP_MAC_ADMIN CAP_MAC_OVERRIDE
ProtectSystem=full
ReadWritePaths=-/etc/farside
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
PrivateTmp=yes
LimitCORE=0

[Install]
WantedBy=multi-user.target
