[Unit]
Description=Farside physical-console host
After=network-online.target systemd-logind.service
Wants=network-online.target

# Restart on failure, but stop after 10 failures in 5 minutes (AUD-FIX F2).
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=exec
User=root
Environment=FARSIDE_CONSOLE_ADDRESS=0.0.0.0
Environment=FARSIDE_CONSOLE_PORT=3391
Environment=FARSIDE_CONSOLE_WORKER=@CMAKE_INSTALL_PREFIX@/bin/farside-console-worker
# The host creates this certificate when it is missing and renews it when it expires within
# 30 days (AUD-FIX7); /etc/farside/console-host.conf may point elsewhere.
Environment=FARSIDE_CONSOLE_CERTIFICATE=/etc/farside/console.crt
Environment=FARSIDE_CONSOLE_CERTIFICATE_KEY=/etc/farside/console.key
# Private codecs in software (HEVC/AV1): auto, never or prefer (KRDPCTL-V2-CONTRACT.md (e)).
Environment=FARSIDE_CONSOLE_SOFTWARE_ENCODING=auto
# Software encoders per codec (OPT-062): auto (follows SoftwareEncoding), allowed, or never (H.264: last-resort).
# Hardware encoders are always allowed; a connection that asks for software gets it only where allowed here.
Environment=FARSIDE_CONSOLE_SOFTWARE_AVC=auto
Environment=FARSIDE_CONSOLE_SOFTWARE_HEVC=auto
Environment=FARSIDE_CONSOLE_SOFTWARE_AV1=auto
Environment=FARSIDE_CONSOLE_QUALITY=80
# The highest quality a client may ask for in its codec request (OPT-066): 0 = the same as QUALITY, else 10-100.
Environment=FARSIDE_CONSOLE_CLIENT_QUALITY_MAX=0
Environment=FARSIDE_CONSOLE_ADAPTIVE_QUALITY=false
Environment=FARSIDE_CONSOLE_PREFER_AUDIO_QUALITY=false
Environment=FARSIDE_CONSOLE_STANDARD_CLIENT_MEDIA=true
Environment=FARSIDE_CONSOLE_CAMERA_LOOPBACK_DEVICE=none
# AV1 tiles for the Farside client: auto, 1, 2, 4, 8 or 16 (KRDPCTL-V2-CONTRACT.md (e)).
Environment=FARSIDE_CONSOLE_AV1_TILES=auto
# Clipboard bridge for text, formatted text and images (OPT-067, OPT-072, OPT-077): both, host-to-client, client-to-host or off. The host narrows it further by state
# (nothing is read back from the login screen, nothing is shared with another account's lock screen).
Environment=FARSIDE_CONSOLE_CLIPBOARD_DIRECTION=both
# File copy (OPT-078): both, host-to-client, client-to-host or off. Only host-to-client is implemented; the clipboard direction above also applies.
Environment=FARSIDE_CONSOLE_CLIPBOARD_FILES=both
# The most a file transfer may take of the link: auto (no ceiling), balanced, or MB/s from 0.1 to 1000. Transfers yield to video and audio either way.
Environment=FARSIDE_CONSOLE_CLIPBOARD_FILE_MAX_RATE=auto
# Free space that must remain on the host after a file copy from the client (OPT-078): bytes or a number with K, M, G or T; 0 = 5% of the filesystem, at least 2 GiB and at most 8 GiB.
Environment=FARSIDE_CONSOLE_CLIPBOARD_FILE_MIN_FREE=0
Environment=FARSIDE_CONSOLE_VAAPI_DRIVER=auto
EnvironmentFile=-/etc/farside/console-host.conf
# Publish the world-readable public-metadata snapshot the settings panel reads without a password.
ExecStartPre=-@KDE_INSTALL_FULL_LIBEXECDIR@/farside-host-settings-helper --publish console
ExecStart=@CMAKE_INSTALL_PREFIX@/bin/farside-console-host --worker ${FARSIDE_CONSOLE_WORKER} --certificate ${FARSIDE_CONSOLE_CERTIFICATE} --certificate-key ${FARSIDE_CONSOLE_CERTIFICATE_KEY} --address ${FARSIDE_CONSOLE_ADDRESS} --port ${FARSIDE_CONSOLE_PORT} --runtime-directory /run/farside-console --quality ${FARSIDE_CONSOLE_QUALITY} --client-quality-max ${FARSIDE_CONSOLE_CLIENT_QUALITY_MAX} --adaptive-quality ${FARSIDE_CONSOLE_ADAPTIVE_QUALITY} --prefer-audio-quality ${FARSIDE_CONSOLE_PREFER_AUDIO_QUALITY} --standard-client-media ${FARSIDE_CONSOLE_STANDARD_CLIENT_MEDIA} --camera-loopback-device ${FARSIDE_CONSOLE_CAMERA_LOOPBACK_DEVICE} --software-encoding ${FARSIDE_CONSOLE_SOFTWARE_ENCODING} --software-avc ${FARSIDE_CONSOLE_SOFTWARE_AVC} --software-hevc ${FARSIDE_CONSOLE_SOFTWARE_HEVC} --software-av1 ${FARSIDE_CONSOLE_SOFTWARE_AV1} --av1-tiles ${FARSIDE_CONSOLE_AV1_TILES} --clipboard-direction ${FARSIDE_CONSOLE_CLIPBOARD_DIRECTION} --clipboard-files ${FARSIDE_CONSOLE_CLIPBOARD_FILES} --clipboard-file-max-rate ${FARSIDE_CONSOLE_CLIPBOARD_FILE_MAX_RATE} --clipboard-file-min-free ${FARSIDE_CONSOLE_CLIPBOARD_FILE_MIN_FREE} --vaapi-driver ${FARSIDE_CONSOLE_VAAPI_DRIVER}
RuntimeDirectory=farside-console
RuntimeDirectoryMode=0711
Restart=on-failure
RestartSec=3
# OPT-055 K6.1: the main thread pings every 10 s; 90 s without a ping means the daemon is deaf.
# systemd then sends SIGABRT (core per host policy) and SIGKILL after TimeoutAbortSec.
WatchdogSec=90s
NotifyAccess=main
TimeoutAbortSec=30s

# REVIEW-S2 hardening (docs/unit-hardening.md has the evidence, the Sol checklist and a one-line rollback per directive).
# This unit's cgroup also holds the capture worker that runs as the logged-in (or greeter) user. The worker inherits seccomp
# filters, the capability bounding set, rlimits, umask, the mount namespace and the device policy, so only what is provably
# harmless to it is set: no LimitCORE (worker cores stay; the host itself calls PR_SET_DUMPABLE 0), no UMask, no PrivateTmp,
# ProtectSystem/Home/Kernel*/ControlGroups/Clock/Hostname, PrivateDevices, MemoryDenyWriteExecute or SystemCallFilter.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# A deny-list of capabilities nothing in the host uses (the module, clock, raw-I/O, BPF, log and MAC ones). No allow-list: the
# PAM stack and GPU drivers are site specific.
CapabilityBoundingSet=~CAP_SYS_MODULE CAP_SYS_RAWIO CAP_SYS_BOOT CAP_SYS_TIME CAP_SYS_PACCT CAP_SYS_TTY_CONFIG CAP_LINUX_IMMUTABLE CAP_MKNOD CAP_WAKE_ALARM CAP_BLOCK_SUSPEND CAP_SYSLOG CAP_BPF CAP_PERFMON CAP_MAC_ADMIN CAP_MAC_OVERRIDE

[Install]
WantedBy=multi-user.target
